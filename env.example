# =========================
# Server Configuration
# =========================
PORT=3001
FLASK_ENV=development
LOG_LEVEL=INFO

# =========================
# Database
# =========================
DATABASE_URL=sqlite:///dev.db

# =========================
# JWT
# =========================
JWT_SECRET=your-super-secure-jwt-secret-key-here

# =========================
# Frontend
# =========================
FRONTEND_URL=http://localhost:3000

# =========================
# Google OAuth
# =========================
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# =========================
# SendGrid Email
# =========================
SENDGRID_API_KEY=your-sendgrid-api-key-here
EMAIL_FROM=your-email@gmail.com

# =========================
# S3 / MinIO (Docker Internal)
# =========================
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=artworks
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# =========================
# Ollama (Local LLM)
# =========================
OLLAMA_BASE_URL=http://host.docker.internal:11434
# One multimodal model for everything (text + image)
OLLAMA_MODEL=gemma3:4b
# Multimodal model used for reflections (so the AI can see the artwork image).
# Pull it with: ollama pull gemma3:4b
OLLAMA_VISION_MODEL=gemma3:4b
# Request timeout (seconds) for all LLM calls
OLLAMA_TIMEOUT=300
# How long Ollama keeps the model loaded between requests (keeps it warm)
OLLAMA_KEEP_ALIVE=5m

# =========================
# AI Provider selection
# =========================
# Which LLM backend the whole app uses: "ollama" (local) or "openai" (paid).
AI_PROVIDER=ollama

# OpenAI — only used when AI_PROVIDER=openai (requires: pip install openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# =========================
# BASE URL
# =========================
# Public-facing base URL of this deployment (used for email links, redirects, etc.)
# Local dev: http://localhost:3001
# Production: https://api.yourdomain.com
BASE_URL=http://localhost:3001
